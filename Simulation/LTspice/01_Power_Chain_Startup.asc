TEXT 0 -448 Left 4 ;OPEN_PHASE - 01 - Power chain start-up : +3.3V -> LT8362 -> +6V -> LT3045-1 -> +5VA / +2.5VA
TEXT 0 -376 Left 2 ;Switching simulation (2 MHz) of the boost soft-start, as built. Full settling of the analog rails: see 02_Analog_Rails_Startup.asc
TEXT -200 176 Left 1 ;Host +3.3V\n(no connector on the board yet)
TEXT 416 112 Left 1 ;C21 + I_VDRIVE =\nAD7606C VDRIVE (1 MSPS)
TEXT 912 -120 Left 1 ;WE-MAPI 4030 74438357022
TEXT 1112 -120 Left 1 ;PMEG2020EH
TEXT 600 304 Left 1 ;SYNC/MODE open\n= pulse-skipping
TEXT 0 -240 Left 3 ;LT8362 BOOST  +3.3V -> +6V, 2 MHz   (schematic sheet ALIMENTATION)
TEXT 3488 344 Left 1 ;PGFB = IN : fast start-up and PG disabled\nVIOC, PG open
TEXT 3840 256 Left 1 ;C1 (x7) = C1 C2 C3 C17 C20 C35 C38\nC5 (x4) = C5 C10 C16 C18
TEXT 4096 256 Left 1 ;I_AVCC = AD7606C AVCC (1 MSPS)\nI_INA = 4 x INA241 IQ\n(3 phases + DC bus)
TEXT 2080 -240 Left 3 ;+5VA : LTC6655-5 (IC7) reference buffered by LT3045-1 (IC8)
TEXT 3488 1224 Left 1 ;PGFB = IN : fast start-up and PG disabled\nVIOC, PG open
TEXT 3840 1136 Left 1 ;C41 = AD7606C REFIN/REFOUT\nI_REF = INA241 REF pins + REFIN (estimate)
TEXT 2080 768 Left 3 ;+2.5VA : LTC6655-2.5 (IC3) reference buffered by LT3045-1 (IC9)
TEXT 0 760 Left 2 !.tran 0 12m 0 20n
TEXT 0 800 Left 2 !.param Iavcc=45m
TEXT 0 840 Left 2 !.save V(+3.3V) V(+6V) V(+5VA) V(+2.5VA) V(SS) V(VC) V(SET5) V(SET2V5) V(REF5) V(REF2V5) I(L1) I(V1)
