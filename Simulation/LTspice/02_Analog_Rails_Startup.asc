TEXT 0 -448 Left 4 ;PhaseSense-8586 - 02 - Analog rails start-up and accuracy : +5VA and +2.5VA
TEXT 0 -376 Left 2 ;The boost is replaced by its settled output (1 ms ramp, see 01). Three runs: the board as built and two corrections of the +2.5VA rail.
TEXT 1560 176 Left 1 ;+6V from the boost\n(1 ms ramp)
TEXT 3488 344 Left 1 ;PGFB = IN : fast start-up and PG disabled\nVIOC, PG open
TEXT 3840 256 Left 1 ;C1 (x6) = C1 C2 C17 C20 C35 C38\nC5 (x3) = C5 C10 C18
TEXT 4096 256 Left 1 ;I_AVCC = AD7606C AVCC (1 MSPS)\nI_INA = 3 x INA241 IQ
TEXT 2080 -240 Left 3 ;+5VA : LTC6655-5 (IC7) reference buffered by LT3045-1 (IC8)
TEXT 2320 1488 Left 1 ;R_NR = PCB link pin 6 (NR) - pin 7 (VOUT)\nas built: 1m  /  removed: 1G
TEXT 3488 1224 Left 1 ;PGFB = IN : fast start-up and PG disabled\nVIOC, PG open
TEXT 3840 1136 Left 1 ;C41 = AD7606C REFIN/REFOUT\nI_REF = INA241 REF pins + REFIN (estimate)
TEXT 2080 768 Left 3 ;+2.5VA : LTC6655LN-2.5 (IC3) reference buffered by LT3045-1 (IC9)
TEXT 0 760 Left 2 !.tran 0 150m 0 20u
TEXT 0 800 Left 2 !.step param run 1 3 1\n.param Rnr=table(run, 1,1m, 2,1G, 3,1G)\n.param R12v=table(run, 1,49.9k, 2,49.9k, 3,24.9k)\n.param Iavcc=45m
TEXT 0 960 Left 2 ;run 1 = as built : LTC6655LN pin 6 (NR) tied to pin 7 (VOUT), R12 = 49.9k\nrun 2 = NR separated from VOUT, R12 = 49.9k\nrun 3 = NR separated from VOUT, R12 = 24.9k (100 uA x 24.9k = 2.49 V, no current in R11)
TEXT 0 1080 Left 2 !.meas tran V5VA AVG V(+5VA) FROM 140m TO 150m\n.meas tran V2V5A AVG V(+2.5VA) FROM 140m TO 150m\n.meas tran VREF5 AVG V(REF5) FROM 140m TO 150m\n.meas tran VREF2V5 AVG V(REF2V5) FROM 140m TO 150m\n.meas tran I_R8 AVG I(R8) FROM 140m TO 150m\n.meas tran I_R11 AVG I(R11) FROM 140m TO 150m\n.meas tran T5_99 WHEN V(+5VA)=4.95 RISE=1\n.meas tran T5_999 WHEN V(+5VA)=4.995 RISE=1\n.meas tran I_6V AVG I(V_6V) FROM 140m TO 150m
