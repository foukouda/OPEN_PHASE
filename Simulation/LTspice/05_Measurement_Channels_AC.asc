TEXT 0 -448 Left 4 ;PhaseSense-8586 - 05 - Measurement channels : frequency response (shunt / divider -> AD7606C pins)
TEXT 0 -376 Left 2 ;k = 1 : AC on the phase current (current channel, V/A).  k = 0 : AC on the phase voltage (voltage channel, V/V).
TEXT -232 152 Left 1 ;ESC phase A\n(J1 pin 1)
TEXT 336 -88 Left 1 ;I_M = motor phase current (J2 pin 3)
TEXT 144 -88 Left 1 ;PBV-R001 shunt
TEXT 1232 200 Left 1 ;AD7606C-18 V6+ / V6- input pins\n(RIN 1.2 Meg to an internal 2 V node, CIN 5 pF)
TEXT 0 -216 Left 3 ;CURRENT CHANNEL  (phase A : R1, IC2, R13, C25, R15 -> AD7606C V6)
TEXT 1232 696 Left 1 ;AD7606C-18 V5+ / V5- input pins\n(RIN 1.2 Meg to an internal 2 V node, CIN 5 pF)
TEXT 0 664 Left 3 ;VOLTAGE CHANNEL  (phase A : R27, R28, Re2, C31, R19 -> AD7606C V5)
TEXT -400 616 Left 1 ;Ideal analog rails\n(see 02 for the real ones)
TEXT -400 1120 Left 2 !.ac dec 100 10 10Meg\n.step param k list 0 1
TEXT -400 1200 Left 2 !.meas ac G_I FIND mag(V(V6+,V6-)) AT 10\n.meas ac F3dB_I WHEN mag(V(V6+,V6-))=G_I/sqrt(2)\n.meas ac G_I_24k FIND mag(V(V6+,V6-)) AT 24k\n.meas ac G_I_2M FIND mag(V(V6+,V6-)) AT 2Meg
TEXT 640 1200 Left 2 !.meas ac G_V FIND mag(V(V5+,V5-)) AT 10\n.meas ac F3dB_V WHEN mag(V(V5+,V5-))=G_V/sqrt(2)\n.meas ac G_V_24k FIND mag(V(V5+,V5-)) AT 24k\n.meas ac G_V_2M FIND mag(V(V5+,V5-)) AT 2Meg
