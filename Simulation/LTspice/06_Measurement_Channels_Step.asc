TEXT -400 1160 Left 2 !.meas tran VI_zero AVG V(V8+,V8-) FROM 50u TO 90u\n.meas tran VI_35A AVG V(V8+,V8-) FROM 550u TO 600u\n.meas tran V8N_bias AVG V(V8-) FROM 550u TO 600u\n.meas tran T_I_1pct WHEN V(V8+,V8-)=VI_zero+0.99*(VI_35A-VI_zero) FALL=1
TEXT 720 1160 Left 2 !.meas tran VV_zero AVG V(V7+,V7-) FROM 50u TO 90u\n.meas tran VV_25V AVG V(V7+,V7-) FROM 250u TO 290u\n.meas tran VOUTU AVG V(OUT-U) FROM 250u TO 290u\n.meas tran T_V_1pct WHEN V(V7+,V7-)=VV_zero+0.99*(VV_25V-VV_zero) RISE=1
